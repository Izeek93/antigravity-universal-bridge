# ==============================================================================
# 🛰 ANTIGRAVITY UNIVERSAL BRIDGE — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Скопируйте этот файл в `.env` и укажите ваши ключи:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🤖 TELEGRAM ADAPTER CONFIGURATION
# ------------------------------------------------------------------------------
# Токен вашего Telegram-бота, полученный у @BotFather:
TG_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# ID разрешённых чатов/пользователей через запятую (узнать свой ID можно через @userinfobot):
# Оставьте пустым, чтобы разрешить первому написавшему пользователю:
ALLOWED_CHAT_IDS=""

# ------------------------------------------------------------------------------
# 2. 🔵 VK (ВКОНТАКТЕ) ADAPTER CONFIGURATION
# ------------------------------------------------------------------------------
# Ключ доступа сообщества ВКонтакте (с правами: «Сообщения», «Фотографии»):
VK_GROUP_TOKEN="vk1.a.your_vk_group_access_token_here"

# Числовой ID сообщества ВКонтакте (без знака минус, например: 123456789):
VK_GROUP_ID=""

# Whitelist пользователей VK через запятую (например: 123456789, 987654321).
# Если пусто — мост автоматически зафиксирует первого входящего администратора:
VK_ALLOWED_USER_IDS=""

# Опционально: Токен пользователя с правами "wall,photos" (нужен ТОЛЬКО если используется автопостинг на стену группы):
VK_USER_TOKEN=""

# ------------------------------------------------------------------------------
# 3. 🎙 ГОЛОСОВЫЕ ОТВЕТЫ И STT (ОПЦИОНАЛЬНО)
# ------------------------------------------------------------------------------
ENABLE_VOICE_REPLIES="True"
WHISPER_LANGUAGE="ru"
WHISPER_MODEL="large-v3-turbo"
